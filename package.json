{
  "name": "erp-tributario-lite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:admin": "tsx src/db/seed-admin.ts",
    "seed:rules": "tsx src/db/seed-rules.ts",
    "seed:company-rules": "tsx --env-file=.env src/db/seed-company-rules.ts",
    "seed:practica": "tsx --env-file=.env src/db/seed-practica.ts",
    "sim:limpieza-caso003": "MIG_URL=\"${DATABASE_MIGRATION_URL:-$DIRECT_URL}\"; test -n \"$MIG_URL\" || { echo 'Sin URL migradora: define DATABASE_MIGRATION_URL o DIRECT_URL (rol migrador/owner, nunca el de la app).' >&2; exit 1; }; psql \"$MIG_URL\" -v company=a1f8bba4-f088-4a71-942a-2fad94820cf0 -f blueprint/datos/casoUso003/limpieza-casoUso003.sql",
    "acceptance:report": "node scripts/acceptance-report.mjs",
    "acceptance:evidence": "node scripts/collect-evidence.mjs",
    "goldens:check": "node --import tsx scripts/validate-goldens.mjs",
    "docs:verify-schema": "tsx scripts/verify-docs-schema.ts",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "golden:inspect": "tsx scripts/golden-inspect.ts",
    "golden:compare": "tsx scripts/golden-compare.ts",
    "goldens:normalize": "tsx scripts/normalize-candidates.ts",
    "g8:calibrate": "tsx scripts/calibrate-rounding.ts",
    "g2:divergence": "tsx scripts/g2-divergence.ts",
    "catalog:load": "tsx scripts/load-catalog-pack.ts",
    "catalog:drift": "tsx scripts/check-drift.ts",
    "catalog:generate": "tsx scripts/generate-matriz.ts",
    "import:autodetect": "tsx scripts/autodetect-report.ts",
    "migration:report": "tsx scripts/migration-report.ts",
    "series:reconcile": "tsx scripts/reconcile-series.ts",
    "render:retry": "tsx --env-file=.env scripts/render-retry.ts",
    "acceptance:gate": "node scripts/acceptance-gate.mjs",
    "audit:check": "node scripts/audit-check.mjs",
    "e2e": "playwright test",
    "e2e:seed": "tsx --env-file=.env e2e/seed.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@node-rs/argon2": "^2.2.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@uploadthing/react": "^7.3.3",
    "ajv": "^8.20.0",
    "apexcharts": "^7.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.36.0",
    "exceljs": "^4.4.0",
    "fast-check": "^4.10.2",
    "next": "^16.0.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.4",
    "puppeteer-core": "^25.12.0",
    "react": "^19.0.0",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "uploadthing": "^7.7.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^16.8.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-boundaries": "^4.2.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "uuid": "^11"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true
  }
}
