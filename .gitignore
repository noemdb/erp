serverc*
*.pem
*.key
id_*
id_*.pub
*.p12
*.pfx
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
!.env.example
# volcados y datos reales (nunca al repo)
*.sql.gz
*.dump
/dumps
/datos-reales

# ── vercel ────────────────────────────────────────────────────
.vercel
.now

# ── uploads / blobs locales ───────────────────────────────────
/uploads
/blob
/tmp

