{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Escenario dorado firmado",
  "description": "Contrato único de unidades (2.0.1 WS2): porcentaje como fracción decimal en string ('0.75'), montos con punto decimal, fechas ISO. Solo casos firmados viven en fixtures/.",
  "type": "object",
  "required": ["id", "descripcion", "origen", "firma", "esperado"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
    "descripcion": { "type": "string", "minLength": 10 },
    "origen": { "type": "string", "enum": ["real", "sintetico"] },
    "firma": {
      "type": "object",
      "required": ["firmado_por", "fecha", "fuente_legal"],
      "properties": {
        "firmado_por": { "type": "string", "minLength": 3 },
        "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "fuente_legal": { "type": "string", "minLength": 5 }
      }
    },
    "doc": {
      "type": "object",
      "required": ["lines", "total"],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["taxCategory", "base"],
            "properties": {
              "taxCategory": { "type": "string" },
              "taxRate": { "type": ["string", "null"], "pattern": "^([0-9]+(\\.[0-9]{1,6})?|null)$" },
              "base": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" },
              "baseGravable": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" }
            }
          }
        },
        "total": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" }
      }
    },
    "iva": {
      "type": "object",
      "required": ["company", "counterparty", "ivaCausado", "rule"],
      "properties": {
        "rule": {
          "type": "object",
          "required": ["ruleVersionId", "ruleSnapshot", "porcentaje"],
          "properties": { "porcentaje": { "type": "string", "pattern": "^0(\\.[0-9]{1,6})?|1(\\.0{1,6})?$" } }
        }
      }
    },
    "ivaEsperado": { "type": "object", "required": ["retainedAmount"] },
    "islr": {
      "type": "object",
      "required": ["baseSujeta", "rule"],
      "properties": {
        "baseSujeta": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" },
        "baseGravable": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" },
        "rule": {
          "type": "object",
          "required": ["porcentaje", "sustraendo"],
          "properties": {
            "porcentaje": { "type": "string", "pattern": "^0(\\.[0-9]{1,6})?|1(\\.0{1,6})?$" },
            "sustraendo": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" }
          }
        }
      }
    },
    "islrEsperado": { "type": "object", "required": ["retainedAmount"] }
  }
}
