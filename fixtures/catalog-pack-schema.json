{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paquete de carga de catálogos (2.0.2 ítem 1)",
  "description": "Solo crea borradores (synthetic=true); la activación la hace el contador. Unidades: porcentaje fracción ('0.75').",
  "type": "object",
  "required": ["version", "fechaCorte", "reglas"],
  "properties": {
    "version": { "type": "string", "pattern": "^v[0-9]+$" },
    "fechaCorte": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "matrizHash": { "type": "string" },
    "reglas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "porcentaje", "base", "vigenciaDesde", "fuente", "articulo"],
        "properties": {
          "kind": { "enum": ["iva", "islr"] },
          "conceptCodigo": { "type": "string" },
          "porcentaje": { "type": "string", "pattern": "^0(\\.[0-9]{1,6})?|1(\\.0{1,6})?$" },
          "sustraendo": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" },
          "base": { "type": "string", "minLength": 1 },
          "vigenciaDesde": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "vigenciaHasta": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "fuente": { "type": "string", "minLength": 3 },
          "articulo": { "type": "string", "minLength": 1 },
          "dorado": { "type": "string" }
        }
      }
    }
  }
}
