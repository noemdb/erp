# Copiar a .env y rellenar. Nunca commitear valores reales.
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rol app (sin owner, sin BYPASSRLS) — ver ARCHITECTURE.md
DATABASE_URL=postgresql://app:changeme@localhost:5432/erp_lite
# Rol migraciones (distinto al de app)
DATABASE_MIGRATION_URL=postgresql://migrator:changeme@localhost:5432/erp_lite
# Runtime mínimo privilegio (1.0.5 §5.2): crear con scripts/create-app-role.mjs.
# Staging/prod: DB_LEAST_PRIVILEGE=true para que el runtime use este rol.
APP_DATABASE_URL=postgresql://app_runtime:changeme@localhost:5432/erp_lite
DB_LEAST_PRIVILEGE=false

AUTH_SECRET=changeme-min-32-chars
FILE_SIGNING_SECRET=changeme-min-32-chars
SESSION_COOKIE_NAME=__Host-session
# __Host- exige Secure (la app lo fuerza siempre) y funciona en localhost por ser origen confiable.
SESSION_TTL_DAYS=7

STORAGE_DRIVER=fs
STORAGE_PATH=./storage
MAX_UPLOAD_MB=10
PGBOSS_SCHEMA=pgboss

LOG_LEVEL=info
# SENTRY_DSN= (solo staging/prod)
# BACKUP_*= (solo prod, fuera del servidor, cifrado)
